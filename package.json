{
  "name": "portfolio-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:works": "node works-interactions.spec.mjs && node works-polish.spec.mjs",
    "test:shared-work-ui": "node works-refinement.spec.mjs && node surface-card.spec.mjs && node work-tag.spec.mjs",
    "test:archive-corrections": "node archive-corrections.spec.mjs && node surface-glow.spec.mjs",
    "test:about-page": "node about-page.spec.mjs && node about-capabilities.spec.mjs && node about-motion.spec.mjs",
    "test:profile-filters": "node home-profile-refinement.spec.mjs && node works-filter-selection.spec.mjs",
    "test:filter-stability": "node works-filter-stability.spec.mjs",
    "test:loading": "node loading.spec.mjs",
    "test:colors": "node colors.spec.mjs",
    "test:home-works": "node home-works.spec.mjs",
    "test:effects": "node global-effects.spec.mjs",
    "test:career": "node career.spec.mjs",
    "test:home-spacing": "node home-spacing.spec.mjs",
    "test:home-about": "node home-about.spec.mjs",
    "test:badge": "node badge.spec.mjs",
    "test:ui-consistency": "node ui-consistency.spec.mjs && node inner-page-design.spec.mjs && node pill-contrast.spec.mjs",
    "test:footer": "node footer-contact.spec.mjs && node footer.spec.mjs",
    "test:audit-fixes": "node audit-fixes.spec.mjs",
    "test:tokens": "node global-tokens.spec.mjs",
    "test:profile-contact": "node profile-contact.spec.mjs",
    "test:footer-nav": "node footer-nav.spec.mjs",
    "test:buttons": "node action-button.spec.mjs",
    "lint": "tsc -b --pretty false"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "esbuild": "^0.28.2",
    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "hls.js": "^1.6.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
